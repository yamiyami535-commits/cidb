MAX_FILE_SIZE_MB=8
MAX_PDF_SIZE_MB=16
# Set a strong secret when the OCR API is called over a network.
API_KEY=
MIN_IMAGE_WIDTH=250
MIN_IMAGE_HEIGHT=150
MIN_BLUR_SCORE=80
MIN_BRIGHTNESS=45
MAX_BRIGHTNESS=225
MIN_OCR_CONFIDENCE=0.65
MIN_NAME_SIMILARITY=85
MANUAL_REVIEW_NAME_SCORE=70
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Explicit backend: onnx (default) or opencv_crossout (stage-one testing only).
# opencv_crossout needs no model/reference files and NEVER approves a document:
# customer/embedded signature detection is not implemented in that backend.
VISUAL_BACKEND=onnx
# Required by onnx only. Missing/invalid packages never fall back to OpenCV.
VISUAL_MANIFEST_PATH=
VISUAL_THREADS=2
VISUAL_TIMEOUT_SECONDS=10
VISUAL_TILE_SIZE=1024
VISUAL_MAX_TILES=32
