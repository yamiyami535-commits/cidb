APP_ENV=local
APP_URL=http://127.0.0.1:8080
SESSION_SECURE_COOKIE=false

DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cidb_portal
DB_USERNAME=cidb_portal
DB_PASSWORD=change-me
DB_TIMEOUT=5

RPA_BOT_ENDPOINT=http://103.241.150.147:8081/api/external/ticket-insert
RPA_BOT_API_KEY=
RPA_BOT_TIMEOUT_MS=15000
RPA_BOT_CONNECT_TIMEOUT_MS=5000
RPA_COMPANY=CIDB
RPA_SCENARIO_KEY=cidb_masterbot
RPA_CHANNEL=Email

# Inbound RPA -> Portal -> private OCR service verification API.
# Set a long random secret in both the RPA caller and the portal environment.
OCR_RPA_API_KEY=
OCR_SERVICE_URL=http://127.0.0.1:8000/api/verify-document
OCR_CONNECT_TIMEOUT_MS=5000
OCR_TIMEOUT_MS=180000
OCR_MAX_FILE_SIZE_MB=8
OCR_MAX_REQUEST_SIZE_MB=17

# Email processing is opt-in. These values are examples/configuration, not activation.
EMAIL_ENABLED=false
EMAIL_IMAP_HOST=mail.daythree.com.my
EMAIL_IMAP_PORT=993
EMAIL_IMAP_ENCRYPTION=ssl
EMAIL_USERNAME=support.rentabot@daythree.com.my
EMAIL_PASSWORD=
# Confirmed dedicated folder; all arrivals are selected regardless of sender.
EMAIL_FOLDER=INBOX.CIDB
EMAIL_BATCH_SIZE=25
EMAIL_TIMEOUT_SECONDS=15
EMAIL_MAX_MESSAGE_BYTES=5242880
# Rules mode is retained for future use; initial launch uses folder-only selection.
EMAIL_SELECTION_MODE=all
EMAIL_ALLOWED_SENDERS=
EMAIL_SUBJECT_PATTERN=
EMAIL_ALLOW_REPLIES=
EMAIL_SELECTION_APPROVED=true
EMAIL_EXTRACTION_APPROVED=false
EMAIL_RPA_CONTRACT_APPROVED=false
EMAIL_RETENTION_APPROVED=false
EMAIL_SMTP_HOST=mail.daythree.com.my
EMAIL_SMTP_PORT=465
EMAIL_SMTP_ENCRYPTION=ssl
# Blank SMTP credentials reuse EMAIL_USERNAME / EMAIL_PASSWORD.
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Rent-A-Bot
EMAIL_TL_ADDRESS=tl@example.invalid
# TL notifications are temporarily commented out in code, including retries.
# Placeholder only: no notification can be sent during this launch.
# EMAIL_NOTIFICATION_SUBJECT=
# EMAIL_NOTIFICATION_BODY=
# EMAIL_NOTIFICATION_MAX_ATTEMPTS=
